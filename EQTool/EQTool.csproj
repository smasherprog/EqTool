<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>EQTool</RootNamespace>
    <AssemblyName>EQTool</AssemblyName>
    <StartupObject>EQTool.App</StartupObject>
    <ApplicationIcon>Images\logo.ico</ApplicationIcon>
    <Configurations>Debug;Release;Beta;Test;Linux</Configurations>
    <Platforms>AnyCPU;x86</Platforms>
    <!-- Version attributes live in Properties\AssemblyInfo.cs. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Properties\Resources.resx holds icons and images, which .NET reads through System.Resources.Extensions. -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Keep the build output in bin\<Configuration>\ so release zips are built from the same folder as before. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <Optimize>true</Optimize>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Beta'">
    <DefineConstants>$(DefineConstants);BETA</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Test'">
    <DefineConstants>$(DefineConstants);RELEASE;TEST</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Linux'">
    <DefineConstants>$(DefineConstants);RELEASE;LINUX</DefineConstants>
  </PropertyGroup>

  <!-- Shipped builds carry their own runtime so users do not have to install .NET, and so the
       self-updater can move a user off the .NET Framework build without a runtime prompt.
       Linux (Wine) builds stay 32-bit, as they were under .NET Framework. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' Or '$(Configuration)' == 'Beta' Or '$(Configuration)' == 'Linux'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x86' Or '$(Configuration)' == 'Linux'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" Version="8.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Speech" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EQToolShared\EQToolShared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Images\**;Files\**;Spells\*.tga;map_files\**" />
    <Resource Include="Images\*.png;Images\logo_t.ico;Images\sickpic.ico;Images\sickpic_t.ico" />
    <Resource Include="Files\TestFight.txt;Files\TestFight2.txt;Files\testmap.txt;Files\VisionFix.zip" />
    <EmbeddedResource Include="Images\logo.ico" />
    <EmbeddedResource Include="Spells\*.tga" />
    <EmbeddedResource Include="map_files\*.txt" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
