<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>EQtoolsTests</RootNamespace>
    <AssemblyName>EQtoolsTests</AssemblyName>
    <Configurations>Debug;Release;Beta;Test;Linux</Configurations>
    <Platforms>AnyCPU;x86</Platforms>
    <!-- DI.cs finds spells_us.txt two folders above the output folder, so keep the output in bin\<Configuration>\. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <IsPackable>false</IsPackable>
    <!-- EQTool is self-contained in shipped configurations; the tests only load its assembly. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EQToolShared\EQToolShared.csproj" />
    <ProjectReference Include="..\EQTool\EQTool.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="LogFiles\log1.txt;spells_us.txt;uifiles\default\*.tga">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="DiscordResponse.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
